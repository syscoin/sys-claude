# Syscoin Claude Config — environment variables
# Copy to .env and fill in values you need.

# -----------------------------------------------------------------------------
# NEVM (EVM L1) — RPC endpoints
# -----------------------------------------------------------------------------
# Mainnet: https://rpc.syscoin.org  (public; consider a paid provider for writes)
# Testnet (Tanenbaum): https://rpc.tanenbaum.io
NEVM_RPC_URL=
NEVM_TESTNET_RPC_URL=

# Optional paid RPC provider (pick one)
ALCHEMY_API_KEY=
QUICKNODE_URL=
BLAST_API_URL=

# Deployer private key — NEVER commit this. Use a dedicated deploy key.
PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Block explorer verification (NEVM uses Blockscout-compatible API)
# -----------------------------------------------------------------------------
# Mainnet: https://explorer.syscoin.org
# Testnet: https://tanenbaum.io
NEVM_EXPLORER_API_URL=
NEVM_EXPLORER_API_KEY=

# -----------------------------------------------------------------------------
# Syscoin Core (UTXO / SPT) — only if you run syscoind locally
# -----------------------------------------------------------------------------
SYSCOIN_RPC_HOST=127.0.0.1
SYSCOIN_RPC_PORT=8370
SYSCOIN_RPC_USER=
SYSCOIN_RPC_PASSWORD=

# -----------------------------------------------------------------------------
# MCP server keys (optional — only if you use the corresponding MCP)
# -----------------------------------------------------------------------------
# None required for the default MCP set (context7, playwright, context-mode, memsearch).
# Add keys here if you install additional MCP servers (e.g. EVM RPC MCP, explorer MCP).
