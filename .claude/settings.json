      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(cast send *mainnet*)",
      "Bash(cast wallet import *)",
      "Bash(forge script * --broadcast*)",
      "Bash(hardhat run * --network mainnet*)",
      "Bash(npx hardhat run * --network mainnet*)",
      "Bash(syscoin-cli sendtoaddress *)",
      "Bash(syscoin-cli sendfrom *)",
      "Bash(syscoin-cli sendmany *)",
      "Bash(syscoin-cli walletpassphrasechange *)",
      "Bash(syscoin-cli dumpwallet *)",
      "Bash(syscoin-cli dumpprivkey *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker system prune *)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '🤖 Syscoin Claude Config is ON 🔗⚡ Core + NEVM development'\necho ''\nif command -v syscoin-cli >/dev/null 2>&1; then\n  echo \"🪙 syscoin-cli: $(syscoin-cli --version 2>/dev/null | head -1 || echo 'not running')\"\nelse\n  echo 'ℹ️  syscoin-cli not installed (optional for NEVM-only projects)'\nfi\nif command -v forge >/dev/null 2>&1; then\n  echo \"🔨 forge: $(forge --version 2>/dev/null | head -1)\"\nfi\nif command -v npx >/dev/null 2>&1 && [ -f package.json ] && grep -q hardhat package.json 2>/dev/null; then\n  echo '📦 hardhat project detected'\nfi"
          }
        ]
      }
    ],

    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"🤖 Agent completed: ${CLAUDE_SUBAGENT_NAME:-unknown}\""
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -z \"$CLAUDE_FILE_PATH\" ]; then exit 0; fi\n\ncase \"$CLAUDE_FILE_PATH\" in\n  *.sol)\n    command -v forge >/dev/null 2>&1 && forge fmt \"$CLAUDE_FILE_PATH\" 2>/dev/null || true\n    ;;\n  *.ts|*.tsx|*.js|*.jsx|*.json|*.md)\n    command -v npx >/dev/null 2>&1 && npx prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true\n    ;;\nesac"
          }
        ]
      },

      {
        "matcher": "Bash",
        "when": {
          "command_matches": "forge test|hardhat test|npx hardhat test"
        },
        "hooks": [
          {
            "type": "command",
            "command": "echo \"\"\necho \"📊 Test Summary:\";\nif [ \"$CLAUDE_TOOL_EXIT_CODE\" -eq 0 ]; then\n  echo \"✅ All tests passed!\"\nelse\n  echo \"❌ Some tests failed. Review output above.\"\nfi"
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Bash",
        "when": {
          "command_matches": "git commit"
        },
        "hooks": [
          {
            "type": "command",
            "command": "set -e\n\necho \"🔍 Running pre-commit checks...\"\n\nif [ -f \"foundry.toml\" ]; then\n  forge fmt --check || { forge fmt; exit 1; }\n  forge build --sizes || exit 1\nfi\n\nif [ -f \"hardhat.config.ts\" ] || [ -f \"hardhat.config.js\" ]; then\n  npx hardhat compile || exit 1\nfi\n\nif [ -f \"package.json\" ]; then\n  npx prettier --check \"**/*.{ts,tsx,js,jsx,json,sol}\" 2>/dev/null || { npx prettier --write \"**/*.{ts,tsx,js,jsx,json,sol}\" 2>/dev/null; exit 1; }\n  [ -f \"tsconfig.json\" ] && npx tsc --noEmit || exit 1\nfi\n\necho \"✅ Pre-commit checks passed\""
          }
        ]
      },

      {
        "matcher": "Bash",
        "when": {
          "command_matches": "forge script.*--broadcast|hardhat run.*--network (nevm|mainnet)|syscoin-cli.*mainnet"
        },
        "hooks": [
          {
            "type": "command",
            "command": "set -e\n\necho \"🚨 PRE-DEPLOY CHECKS\"\necho \"⚠️  This appears to be a mainnet or broadcasting operation.\"\necho \"Type 'DEPLOY TO NEVM MAINNET' to continue:\";\nread -r CONFIRM;\n[ \"$CONFIRM\" = \"DEPLOY TO NEVM MAINNET\" ] || exit 1\necho \"✅ Pre-deploy checks passed\""
          }
        ]
      }
    ]
  },

  "modelDefaults": {
    "agent": "opus",
    "command": "sonnet"
  }
}
